#----------------------------------------------------------------------------
# Ignore these files when commiting to a git repository.
#
# See http://help.github.com/ignore-files/ for more about ignoring files.
#
# The original version of this file is found here:
# https://github.com/RailsApps/rails3-application-templates/raw/master/files/gitignore.txt
#
# Corrections? Improvements? Create a GitHub issue: 
# http://github.com/RailsApps/rails3-application-templates/issues
#----------------------------------------------------------------------------

# bundler state
/.bundle
/vendor/bundle/

# minimal Rails specific artifacts
db/*.sqlite3
/log/*
/tmp/*

# various artifacts
**.war
*.rbc
*.sassc
# .rspec is configuration, not an artifact. Ignoring it meant `rspec` ran without
# --require spec_helper, so the support chain differed between developers and CI.
# (S2 / P1-CI-02)
.redcar/
.sass-cache
/config/config.yml
# config/database.yml is tracked. It was ignored, so a clone had no database config at
# all and Rails could not boot — and the S1 rewrite that removed the hardcoded
# postgres/postgres credentials never reached the repository. The file now contains only
# ENV.fetch with no fallback, so there is nothing in it to hide. (S2 / P1-CI-02)
/coverage.data
/coverage/
/db/*.javadb/
/db/*.sqlite3
/doc/api/
/doc/app/
/doc/features.html
/doc/specs.html
/public/cache
/public/stylesheets/compiled
/public/system/*
/spec/tmp/*
/cache
/capybara*
/capybara-*.html
/gems
# NOTE: /spec/requests, /spec/routing and /spec/views were ignored here (S1 / P0-WH-02).
# They are our own test suites, not generated artefacts — this rule is a leftover from an
# old rdoc/rspec-1 template. It hid 6 of 15 spec files from the repo and from CI, which is
# why the pipeline could report green while executing no request specs at all.
/specifications
rerun.txt
pickle-email-*.html

# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile ~/.gitignore_global
#
# Here are some files you may want to ignore globally:

# scm revert files
**.orig

# Mac finder artifacts
.DS_Store

# Netbeans project directory
/nbproject/

# RubyMine project files
.idea

# Textmate project files
/*.tmproj

# vim artifacts
**.swp

*.old
*.jar
xerial*.*

.env
/config/master.key

# Ignore key files for decrypting credentials and more.
/config/*.key


# Local-only port publishing for host-run tests (S1 / P0-NET-01)
docker-compose.override.yml
