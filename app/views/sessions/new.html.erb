<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LUXE OMS - Enterprise Control Center Login</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "dashboard", media: "all" %>
  <style>
    body {
      margin: 0;
      padding: 0;
      min-height: 100vh;
      background: #060e20;
      background-image: 
        radial-gradient(circle at 50% 20%, rgba(128, 131, 255, 0.08) 0%, transparent 60%),
        linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      background-size: 100% 100%, 40px 40px, 40px 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .login-card {
      width: 440px;
      max-width: 90vw;
      background: rgba(23, 31, 51, 0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 20px;
      padding: 40px 36px;
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6);
      animation: modalZoomIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .form-input {
      width: 100%;
      background: var(--surface-container-low);
      border: 1px solid var(--border-highlight);
      border-radius: 10px;
      padding: 14px 16px;
      color: #fff;
      font-size: 14px;
      font-family: 'Plus Jakarta Sans', sans-serif;
      box-sizing: border-box;
      transition: border-color 0.2s ease;
    }
    .form-input:focus {
      outline: none;
      border-color: var(--primary-neon);
    }
    .btn-login {
      width: 100%;
      background: linear-gradient(135deg, #8083ff, #6366f1);
      color: #fff;
      font-weight: 800;
      font-size: 14px;
      font-family: 'Outfit', sans-serif;
      letter-spacing: 0.05em;
      border: none;
      border-radius: 10px;
      padding: 14px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
      box-shadow: 0 8px 20px rgba(128, 131, 255, 0.3);
    }
    .btn-login:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 24px rgba(128, 131, 255, 0.4);
    }
    .btn-login:active {
      transform: scale(0.98);
    }
  </style>
</head>
<body>

  <div class="login-card">
    <% if flash[:alert].present? %>
      <div class="flash-banner flash-alert" style="margin-bottom: 20px;">
        <span><%= flash[:alert] %></span>
      </div>
    <% end %>

    <% if flash[:notice].present? %>
      <div class="flash-banner flash-notice" style="margin-bottom: 20px;">
        <span><%= flash[:notice] %></span>
      </div>
    <% end %>

    <!-- Header Logo & Live Status -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px;">
      <div>
        <h1 style="font-size: 28px; font-weight: 800; color: #fff; font-family: 'Outfit'; margin: 0; letter-spacing: -0.5px;">
          LUXE OMS
        </h1>
        <p style="font-size: 12px; color: var(--on-surface-variant); margin: 4px 0 0 0;">
          Enterprise Fulfillment Control Center
        </p>
      </div>
      <div class="live-status" style="background: rgba(16, 185, 129, 0.12); border: 1px solid var(--secondary-emerald); padding: 4px 10px; border-radius: 20px;">
        <div class="pulse-dot"></div>
        <span style="font-size: 11px; font-weight: 700; color: var(--secondary-emerald); font-family: var(--font-tech);">ONLINE</span>
      </div>
    </div>

    <%= form_with url: login_path, method: :post, local: true do |f| %>

      <!-- Staff Email Input -->
      <div style="margin-bottom: 20px;">
        <label style="font-size: 11px; font-family: var(--font-tech); font-weight: 700; color: var(--on-surface-variant); display: block; margin-bottom: 6px; text-transform: uppercase;">
          👤 Email / Username
        </label>
        <%= f.text_field :email, placeholder: "e.g. budi@boutiquehijab.id", required: true, class: "form-input" %>
      </div>

      <!-- Password Input -->
      <div style="margin-bottom: 24px;">
        <label style="font-size: 11px; font-family: var(--font-tech); font-weight: 700; color: var(--on-surface-variant); display: block; margin-bottom: 6px; text-transform: uppercase;">
          🔑 Password
        </label>
        <div style="position: relative;">
          <%= f.password_field :password, id: "password-input", placeholder: "••••••••••••••••", required: true, class: "form-input", style: "font-family: var(--font-tech);" %>
          <span style="position: absolute; right: 14px; top: 50%; transform: translateY(-50%); cursor: pointer; color: var(--on-surface-variant);" onclick="togglePassword();">👁️</span>
        </div>
      </div>

      <!-- Checkbox & Forgot Link Row -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; font-size: 12px; color: var(--on-surface-variant);">
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
          <input type="checkbox" checked style="accent-color: var(--primary-neon);">
          <span>Remember Session</span>
        </label>
        <a href="#" style="color: var(--on-surface-variant); text-decoration: none;" onclick="alert('Contact Level 3 Command Center for password reset.'); return false;">Forgot Password?</a>
      </div>

      <!-- Submit Button -->
      <%= f.submit "SIGN IN TO CONTROL CENTER ➔", class: "btn-login" %>
    <% end %>

    <!-- Quick Demo Accounts Helper -->
    <div style="margin-top: 28px; padding-top: 20px; border-top: 1px dashed var(--border-highlight); font-size: 11px; color: var(--on-surface-variant);">
      <div style="font-weight: 700; color: #fff; margin-bottom: 10px; font-family: var(--font-tech);">💡 DEMO ACCOUNTS (Click to Fill):</div>
      <div style="display: flex; gap: 8px; flex-wrap: wrap;">
        <button type="button" style="background: var(--surface-container-low); border: 1px solid var(--border-highlight); border-radius: 6px; padding: 8px 12px; color: var(--primary-neon); font-family: var(--font-tech); cursor: pointer; font-size: 11px;" onclick="fillDemo('budi@boutiquehijab.id', 'secret123');">
          👤 Budi (Boutique Hijab)
        </button>
        <button type="button" style="background: var(--surface-container-low); border: 1px solid var(--border-highlight); border-radius: 6px; padding: 8px 12px; color: var(--secondary-emerald); font-family: var(--font-tech); cursor: pointer; font-size: 11px;" onclick="fillDemo('siti@gamiselegant.id', 'secret123');">
          👤 Siti (Gamis Elegant)
        </button>
      </div>
    </div>
  </div>

  <script>
    function fillDemo(email, pass) {
      document.querySelector('input[name="email"]').value = email;
      document.getElementById('password-input').value = pass;
    }

    function togglePassword() {
      const input = document.getElementById('password-input');
      if (input.type === 'password') {
        input.type = 'text';
      } else {
        input.type = 'password';
      }
    }
  </script>
</body>
</html>
