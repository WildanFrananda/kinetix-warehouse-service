<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Shipping Label - <%= @label ? @label.awb_number : 'AWB' %></title>
  <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
  <style>
    @page {
      size: 100mm 150mm;
      margin: 0;
    }
    body {
      width: 100mm;
      height: 150mm;
      margin: 0 auto;
      padding: 12px;
      box-sizing: border-box;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      color: #000;
      background: #fff;
    }
    .label-box {
      border: 2px solid #000;
      height: 100%;
      padding: 10px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-sizing: border-box;
    }
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid #000;
      padding-bottom: 8px;
    }
    .logo {
      font-size: 18px;
      font-weight: 900;
      letter-spacing: -0.5px;
    }
    .courier-tag {
      background: #000;
      color: #fff;
      padding: 4px 8px;
      font-size: 12px;
      font-weight: bold;
    }
    .barcode-section {
      text-align: center;
      padding: 8px 0;
      border-bottom: 2px solid #000;
    }
    #barcode {
      width: 85%;
      height: auto;
      max-height: 70px;
    }
    .address-section {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      border-bottom: 2px solid #000;
      padding: 8px 0;
      font-size: 11px;
    }
    .address-title {
      font-weight: bold;
      text-transform: uppercase;
      font-size: 10px;
      color: #555;
      margin-bottom: 4px;
    }
    .manifest-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 10px;
      margin-top: 8px;
    }
    .manifest-table th, .manifest-table td {
      border: 1px solid #000;
      padding: 4px;
      text-align: left;
    }
    .manifest-table th {
      background: #eee;
    }
    .footer {
      font-size: 9px;
      text-align: center;
      color: #666;
      border-top: 1px dashed #000;
      padding-top: 6px;
    }
  </style>
</head>
<body>
  <div class="label-box">
    <div class="header">
      <div class="logo">⚡ FLEETPULSE EXPRESS</div>
      <div class="courier-tag">SAME-DAY</div>
    </div>

    <div class="barcode-section">
      <!-- Real Scannable CODE128 Barcode Vector -->
      <svg id="barcode"></svg>
      <div style="font-size: 10px; font-weight: bold; margin-top: 2px;">Order #<%= @order ? @order.order_number : '' %></div>
    </div>

    <div class="address-section">
      <div>
        <div class="address-title">SHIP FROM (PENGIRIM):</div>
        <strong><%= @merchant ? @merchant.name : 'Merchant Store' %></strong><br>
        Cutoff SLA: <%= @merchant ? "#{@merchant.cutoff_hour}:00 WIB" : '14:00' %>
      </div>
      <div>
        <div class="address-title">SHIP TO (PENERIMA):</div>
        <strong><%= @task ? @task.order_number : '-' %></strong><br>
        
        <em>recipient details are held by order-service</em>
      </div>
    </div>

    <div>
      <div class="address-title">ITEM MANIFEST:</div>
      <table class="manifest-table">
        <thead>
          <tr>
            <th>SKU</th>
            <th>Item Name</th>
            <th>Qty</th>
          </tr>
        </thead>
        <tbody>
          <% if @task && @task.fulfillment_task_lines.any? %>
            <% @task.fulfillment_task_lines.each do |item| %>
              <tr>
                <td><%= item.sku %></td>
                <td><%= item.sku %></td>
                <td><%= item.quantity %></td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="3">Standard Fulfillment Item</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="footer">
      Reprint Count: <%= @label ? @label.reprint_count : 1 %> | Printed via Fashion Fulfillment OMS Engine
    </div>
  </div>

  <script>
    window.onload = function() {
      // Render 100% Real Scannable Code128 Barcode
      const awbNumber = "<%= @label ? @label.awb_number : 'AWB-1001-DEMO' %>";
      JsBarcode("#barcode", awbNumber, {
        format: "CODE128",
        width: 2,
        height: 60,
        displayValue: true,
        fontSize: 14,
        margin: 0
      });

      // Auto trigger print dialog
      setTimeout(function() {
        window.print();
      }, 300);
    };
  </script>
</body>
</html>
