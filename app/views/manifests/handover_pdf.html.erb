<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Courier Handover Manifest - <%= @current_merchant ? @current_merchant.name : 'Fulfillment OMS' %></title>
  <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
  <style>
    @page {
      size: A4 portrait;
      margin: 15mm;
    }
    body {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      color: #000;
      background: #fff;
      margin: 0;
      padding: 20px;
    }
    .header-table {
      width: 100%;
      border-collapse: collapse;
      border-bottom: 3px solid #000;
      padding-bottom: 12px;
      margin-bottom: 16px;
    }
    .title {
      font-size: 20px;
      font-weight: bold;
    }
    .subtitle {
      font-size: 11px;
      color: #555;
    }
    .manifest-info {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 16px;
      font-size: 12px;
    }
    .manifest-info td {
      padding: 6px;
      border: 1px solid #ccc;
    }
    .manifest-info th {
      background: #f0f0f0;
      padding: 6px;
      border: 1px solid #ccc;
      text-align: left;
    }
    .data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 11px;
      margin-bottom: 24px;
    }
    .data-table th, .data-table td {
      border: 1px solid #000;
      padding: 8px;
      text-align: left;
    }
    .data-table th {
      background: #e2e8f0;
      font-weight: bold;
    }
    .signature-container {
      display: flex;
      justify-content: space-between;
      margin-top: 40px;
      page-break-inside: avoid;
    }
    .signature-box {
      width: 45%;
      text-align: center;
      font-size: 12px;
    }
    .signature-line {
      margin-top: 60px;
      border-top: 1px solid #000;
      padding-top: 4px;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <% 
    merchant_code = @current_merchant ? @current_merchant.code : 'MERCHANT'
    manifest_ref = "MNF-#{merchant_code}-#{Time.current.strftime('%Y%m%d%H%M')}"
  %>

  <table class="header-table">
    <tr>
      <td>
        <div class="title">⚡ FLEETPULSE EXPRESS - COURIER HANDOVER MANIFEST</div>
        <div class="subtitle">SURAT JALAN SERAH TERIMA PAKET GUDANG (WAREHOUSE PICKUP MANIFEST)</div>
      </td>
      <td style="text-align: right;">
        <!-- Real Scannable CODE128 Vector Barcode Engine -->
        <svg id="manifest-barcode"></svg>
      </td>
    </tr>
  </table>

  <table class="manifest-info">
    <tr>
      <th>MERCHANT PENGIRIM:</th>
      <td><%= @current_merchant ? @current_merchant.name : '-' %> (Code: <%= merchant_code %>)</td>
      <th>WAKTU DISPATCH:</th>
      <td><%= Time.current.strftime("%d %B %Y - %H:%M WIB") %></td>
    </tr>
    <tr>
      <th>GUDANG ASAL:</th>
      <td>Central Fashion Warehouse Jakarta</td>
      <th>TOTAL PAKET DISPATCH:</th>
      <td><strong><%= (@dispatched_orders || []).size %> Paket</strong></td>
    </tr>
  </table>

  <table class="data-table">
    <thead>
      <tr>
        <th style="width: 30px;">No</th>
        <th>Order Number</th>
        <th>Jumlah Item</th>
        <th>Status Gudang</th>
      </tr>
    </thead>
    <tbody>
      <% if (@dispatched_orders || []).empty? %>
        <tr>
          <td colspan="6" style="text-align: center;">Tidak ada paket dalam daftar surat jalan ini.</td>
        </tr>
      <% else %>
        <% (@dispatched_orders || []).each_with_index do |ord, idx| %>
          <tr>
            <td style="text-align: center;"><%= idx + 1 %></td>
            <td><strong>#<%= ord.order_number %></strong></td>
                                    <td style="text-align: center;"><%= ord.fulfillment_task_lines.sum(:quantity) %> pcs</td>
            <td><%= ord.status.tr('_', ' ').capitalize %></td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>

  <div class="signature-container">
    <div class="signature-box">
      <div>DISERAHKAN OLEH (STAF GUDANG):</div>
      <div class="signature-line">
        ( __________________________ )<br>
        Warehouse Operator
      </div>
    </div>
    <div class="signature-box">
      <div>DITERIMA OLEH (DRIVER FLEETPULSE):</div>
      <div class="signature-line">
        ( __________________________ )<br>
        Driver Kurir FleetPulse
      </div>
    </div>
  </div>

  <script>
    window.onload = function() {
      // Dynamically Render Real Scannable CODE128 Manifest Barcode
      const manifestRefCode = "<%= manifest_ref %>";
      JsBarcode("#manifest-barcode", manifestRefCode, {
        format: "CODE128",
        width: 1.8,
        height: 45,
        displayValue: true,
        fontSize: 12,
        margin: 0
      });

      // Auto trigger print dialog
      setTimeout(function() {
        window.print();
      }, 300);
    };
  </script>
</body>
</html>
