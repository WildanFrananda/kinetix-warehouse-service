# Copy to .env and fill every secret in. Values are intentionally blank: services
# fail to start when a required secret is missing rather than falling back to a
# shared committed default (S1 / P0-SEC-02).
# Generate one with:  head -c 48 /dev/urandom | base64
# Never commit the filled-in .env, and never reuse a value across services.

# Kinetix Warehouse OMS Environment Variables

PORT=3000
GRPC_PORT=50051
REDIS_URL=redis://localhost:6379/0

# bin/grpc_server serves no HTTP of its own, so it binds this port for GET /metrics and nothing
# else. It defaults to 3000, which is what the platform scrapes for every other service and is
# free inside the gRPC container — but it collides with `bin/rails server` when both are run on
# one host, so set it when running the two side by side locally.
# METRICS_PORT=3000

# How long work already in flight has to finish after SIGTERM, in seconds. Puma passes it to
# force_shutdown_after and GrpcServer to the RPC server's shutdown deadline. It must stay below
# the container's stop_grace_period (30s in kinetix-infrastructure/compose.yaml), because at the
# end of that Docker sends SIGKILL and nothing gets to finish or to say so. Default 20.
# KINETIX_DRAIN_SECONDS=20

# What kinetix_build_info reports as this build's version. Defaults to the VERSION file at the
# repository root.
# KINETIX_SERVICE_VERSION=

# The five names config/database.yml actually reads. DB_USERNAME and DB_PASSWORD go through
# ENV.fetch with NO default, so a missing one is a KeyError naming it rather than a silent
# connection as a superuser.
#
# There is deliberately no DATABASE_URL here any more. This file used to carry one
# (…@localhost:5439/…, with an empty password); nothing in this repository reads that name, but
# Rails merges DATABASE_URL over database.yml whenever it is set — so anyone who copied this file
# verbatim got a URL pointing at a port nothing listens on, with the DB_* values below silently
# ignored, and a connection error that named none of it. kinetix-infrastructure's compose.yaml sets
# the same five names (DB_HOST: kinetix-warehouse-db, DB_PORT: "5432") and no URL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kinetix_warehouse_dev
DB_USERNAME=kinetix_warehouse_app
DB_PASSWORD=

# lib/kinetix/token_verifier.rb reads all three through require_env, which raises on a missing
# name, and spec/support/identity_tokens.rb signs its test tokens with the issuer and audience.
# Not secrets — the issuer and audience are public claim values and the JWKS document is public.
# Both CI pipelines set the same three; keep them in step.
JWT_ISSUER=https://identity.kinetix.local
JWT_AUDIENCE=kinetix
IDENTITY_JWKS_URL=http://identity:3000/.well-known/jwks.json

# How long a duplicate reserve or release waits on the original it collided with, in seconds.
# Default 15, clamped to 1..120. It must stay above the calling service's gRPC deadline; see
# docs/stock_idempotency_runbook.md, "The one knob".
# WAREHOUSE_STOCK_LOCK_TIMEOUT_SECONDS=15

# How old a still-held stock_reservations row must be before the abandoned-hold report names it.
# Default 24 hours. See docs/stock_idempotency_runbook.md, "A hold nobody is coming back for".
# WAREHOUSE_ABANDONED_HOLD_HOURS=24
