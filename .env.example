# Copy to .env and fill every secret in. Values are intentionally blank: services
# fail to start when a required secret is missing rather than falling back to a
# shared committed default (S1 / P0-SEC-02).
# Generate one with:  head -c 48 /dev/urandom | base64
# Never commit the filled-in .env, and never reuse a value across services.
#
# Every variable the service reads is listed here. A line that is commented out has a default in
# code, and the comment says what it is; a line that is not commented out is required.

# ── Rails ─────────────────────────────────────────────────────────────────────────────────────────
# Production reads its credentials with this key; config/master.key holds it locally.
RAILS_MASTER_KEY=
# RAILS_ENV=development
# RAILS_LOG_LEVEL=info
# Puma threads, and the size of the database pool. Defaults 3 (Puma) and 5 (pool).
# RAILS_MAX_THREADS=3
# Solid Queue: run the supervisor inside Puma, and how many worker processes it starts. Default 1.
# SOLID_QUEUE_IN_PUMA=true
# JOB_CONCURRENCY=1
# Puma writes a pid file only when this is set.
# PIDFILE=
# db/seeds.rb refuses to run in production unless this is "yes": it deletes every merchant and task.
# ALLOW_DESTRUCTIVE_SEED=

# ── Ports ─────────────────────────────────────────────────────────────────────────────────────────
# Puma's port. Default 3000.
PORT=3000
# The gRPC server's port (bin/grpc_server, bin/grpc_healthcheck). Required.
GRPC_PORT=50051
# bin/grpc_server serves GET /metrics on its own port. Default 3000; set it when running the web
# and gRPC processes side by side on one host.
# METRICS_PORT=3000
# Thruster (the image's CMD) listens on HTTP_PORT and forwards to Puma on TARGET_PORT.
# HTTP_PORT=80
# TARGET_PORT=3000
# The name bin/grpc_healthcheck dials; it must match the server certificate. Default kinetix-warehouse-grpc.
# KINETIX_GRPC_SELF_HOST=kinetix-warehouse-grpc

# How long work in flight has to finish after SIGTERM, in seconds. Keep it below the container's
# stop_grace_period. Default 20.
# KINETIX_DRAIN_SECONDS=20
# What kinetix_build_info reports. Defaults to the VERSION file.
# KINETIX_SERVICE_VERSION=

# ── Database ──────────────────────────────────────────────────────────────────────────────────────
# DB_USERNAME and DB_PASSWORD have no default. There is deliberately no DATABASE_URL: Rails merges it
# over config/database.yml whenever it is set.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kinetix_warehouse_dev
DB_USERNAME=kinetix_warehouse_app
DB_PASSWORD=
# The test database's name. Default kinetix_warehouse_test.
# TEST_DB_NAME=kinetix_warehouse_test

# ── Identity's tokens ─────────────────────────────────────────────────────────────────────────────
# Required. Not secrets: the issuer and audience are public claim values and the JWKS is public.
JWT_ISSUER=https://identity.kinetix.local
JWT_AUDIENCE=kinetix
IDENTITY_JWKS_URL=http://kinetix-identity-service:5000/.well-known/jwks.json

# ── The mesh ──────────────────────────────────────────────────────────────────────────────────────
# The services this one calls over gRPC. Required: a guessed address fails in silence.
IDENTITY_GRPC_HOST=kinetix-identity-service:50052
ORDER_GRPC_HOST=kinetix-order-service:50055
# Who may call this service's gRPC surface, by SPIFFE service name. Required. `warehouse` is there
# for the container's own health probe.
KINETIX_GRPC_ALLOWED_PEERS=catalog,order,warehouse
# The directory holding tls.crt, tls.key and ca.pem. Default /pki, which exists only in a container;
# locally point it at kinetix-infrastructure/pki/warehouse.
# KINETIX_PKI_DIR=/pki
# The trust domain a peer certificate must carry; a comma-separated list during a cutover.
# Default kinetix.local.
# KINETIX_TRUST_DOMAIN=kinetix.local

# ── Warehouse rules ───────────────────────────────────────────────────────────────────────────────
# The platform's clock, an IANA zone name. A merchant's cutoff_hour is an hour on this clock.
# Required: the service refuses to start without it, or with a name that is not a zone.
KINETIX_TIME_ZONE=Asia/Jakarta
# CheckBinStock sets low_stock_warning when fewer units than this are available in the bin.
# Required, a whole number, zero or more; zero turns the warning off.
WAREHOUSE_LOW_STOCK_THRESHOLD=5
# How long a duplicate reserve or release waits on the original it collided with, in seconds.
# Default 15, clamped to 1..120. See docs/stock_idempotency_runbook.md, "The one knob".
# WAREHOUSE_STOCK_LOCK_TIMEOUT_SECONDS=15
# How old a held reservation must be before the abandoned-hold report names it. Default 24 hours.
# WAREHOUSE_ABANDONED_HOLD_HOURS=24
