#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "grpc"
require "grpc/health/v1/health_services_pb"
require_relative "../lib/kinetix/service_identity"

identity = Kinetix::ServiceIdentity.new
port = Integer(ENV.fetch("GRPC_PORT"))
authority = ENV.fetch("KINETIX_GRPC_SELF_HOST", "kinetix-warehouse-grpc")

stub = Grpc::Health::V1::Health::Stub.new(
  "#{authority}:#{port}",
  identity.channel_credentials,
  timeout: 8
)

response = stub.check(Grpc::Health::V1::HealthCheckRequest.new)
exit(response.status == :SERVING ? 0 : 1)
